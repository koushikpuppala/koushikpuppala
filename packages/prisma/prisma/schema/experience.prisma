model Experience {
  id      String @id @default(uuid()) @db.Uuid
  version Int    @default(1)

  title          String
  company        String
  location       String
  employmentType EmploymentType @map("employment_type")

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  isCurrent Boolean @default(false) @map("is_current")
  featured  Boolean @default(false)

  description  String[]
  achievements String[]
  technologies String[]

  website String?

  logoId String? @map("logo_id") @db.Uuid
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0) @map("sort_order")

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([logoId], map: "experience_logo_id_index")
  @@index([featured], map: "experience_featured_index")
  @@index([isPublished, deletedAt, sortOrder], map: "experience_published_deleted_sort_index")
  @@map("experience")
}

enum EmploymentType {
  FULL_TIME @map("full_time")
  PART_TIME @map("part_time")
  INTERN    @map("intern")
  CONTRACT  @map("contract")
  FREELANCE @map("freelance")
}
