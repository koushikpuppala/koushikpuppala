model Service {
  id      String @id @default(uuid()) @db.Uuid
  version Int    @default(1)

  title       String
  description String   @db.Text
  features    String[]

  imageId String? @map("image_id") @db.Uuid
  image   Media?  @relation(fields: [imageId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0) @map("sort_order")

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([imageId], map: "service_image_id_index")
  @@index([isPublished, deletedAt, sortOrder], map: "service_published_deleted_sort_index")
  @@map("services")
}
