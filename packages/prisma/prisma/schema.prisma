generator client {
  runtime         = "nodejs"
  provider        = "prisma-client"
  output          = "../src/generated"
  // Explicit undefined in queries is rejected; DatabaseService strips it from writes via
  // omitUndefinedWrites.
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider     = "postgresql"
  // Relations are emulated by Prisma rather than enforced by foreign keys, so every relation field
  // needs its own @@index.
  relationMode = "prisma"
}
