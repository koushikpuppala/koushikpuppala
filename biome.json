{
	"$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"lineWidth": 100,
		"bracketSameLine": true,
		"expand": "auto"
	},
	"linter": {
		"enabled": true,
		"domains": { "next": "recommended", "react": "recommended" },
		"rules": { "recommended": true, "suspicious": { "noUnknownAtRules": "off" } }
	},
	"javascript": {
		"formatter": {
			"jsxQuoteStyle": "single",
			"trailingCommas": "all",
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded",
			"quoteStyle": "single"
		}
	},
	"html": { "formatter": { "indentScriptAndStyle": true, "selfCloseVoidElements": "always" } },
	"css": { "parser": { "tailwindDirectives": true }, "formatter": { "quoteStyle": "single" } },
	"assist": { "actions": { "source": { "recommended": true, "organizeImports": "off" } } }
}
