{
	"name": "koushikpuppala",
	"description": "My website was developed using the Next.js framework and the TypeScript programming language and hosted on the Vercel cloud platform. It contains blogs, a portfolio, and a contact form.",
	"type": "module",
	"version": "5.7.5",
	"main": "next.config.ts",
	"packageManager": "pnpm@10.19.0",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "eslint .",
		"prepare": "husky || true",
