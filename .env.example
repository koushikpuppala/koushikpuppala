# This file is the single source of environment variables for the whole monorepo (copy to .env)

# Build a standalone server for the Docker image (docker or local; the Dockerfiles set it)
# ENVIRONMENT = "docker"

# PostgreSQL connection URI (API, migrations, Prisma Studio and the seed script)
DATABASE_URL = "postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require"

# Public API URL without trailing slash (the API's own URL; client and admin call it, inlined at build time)
NEXT_PUBLIC_BASE_URL = "http://localhost:8080"

# Public site URL without trailing slash (client metadata, canonical URLs, sitemap and robots; the API's
# links and default revalidation target)
NEXT_PUBLIC_DEPLOY_URL = "http://localhost:3000"

# Shared secret for on-demand revalidation of apps/client (leave empty to disable)
REVALIDATE_SECRET = "top-secret"

# Sentry: one project per app (client, admin and the API's SENTRY_DSN below). Each is optional and
# error tracking is on for an app when its DSN is set

# Public Sentry DSNs for the client and admin projects (inlined at build time)
NEXT_PUBLIC_CLIENT_SENTRY_DSN = ""
NEXT_PUBLIC_ADMIN_SENTRY_DSN = ""

# Sentry organization and auth token, shared by every project (source map uploads in CI/CD)
SENTRY_ORG = ""
SENTRY_AUTH_TOKEN = ""

# Sentry project slugs that receive the client and admin source maps
SENTRY_CLIENT_PROJECT = ""
SENTRY_ADMIN_PROJECT = ""

# Runtime environment (development, production or test). Next.js sets NODE_ENV itself, so only
# the API reads it from here
NODE_ENV = "development"

# Application name, also used as the Firebase Admin app name
APP_NAME = "koushikpuppala"

# Port the API listens on (Next.js ignores PORT in .env files, so client and admin keep their own ports)
PORT = "8080"

# Allowed CORS origins (comma separated)
ORIGIN = "http://localhost:3000,http://localhost:3001"

# Proxies trusted to set X-Forwarded-For (hop count, true/false, or subnets)
TRUST_PROXY = "loopback, linklocal, uniquelocal"

# Revalidation target when it differs from NEXT_PUBLIC_DEPLOY_URL (optional)
# REVALIDATE_URL = "http://localhost:3000"

# PostgreSQL pool settings (timeouts in milliseconds)
DATABASE_MAX_CONNECTIONS = "10"
DATABASE_IDLE_TIMEOUT = "30000"
DATABASE_CONNECTION_TIMEOUT = "10000"

# Redis cache and session store (timeouts in milliseconds; password required in production)
REDIS_HOST = "127.0.0.1"
REDIS_PORT = "6379"
REDIS_USERNAME = ""
REDIS_PASSWORD = ""
REDIS_DB = "0"
REDIS_LAZY_CONNECT = "true"
REDIS_CONNECT_TIMEOUT = "10000"
REDIS_KEEP_ALIVE = "30000"
REDIS_MAX_RETRIES_PER_REQUEST = "3"

# Connect to Redis over TLS (optional, off when unset)
# REDIS_TLS = "true"

# Firebase Admin Configuration (private key with escaped \n line breaks; the project ID is
# NEXT_PUBLIC_FIREBASE_PROJECT_ID below)
FIREBASE_CLIENT_EMAIL = ""
FIREBASE_PRIVATE_KEY = ""

# AWS S3 storage for media uploads and the public CDN URL for stored files (the client and admin
# image optimizers allow only this host, and the API only accepts OpenGraph images from it)
AWS_REGION = ""
S3_BUCKET = ""
CDN_URL = "https://<bucket>.s3.<region>.amazonaws.com"

# Contact form emails through AWS SES, in AWS_REGION (the instance role needs
# ses:SendEmail). Each submission emails CONTACT_NOTIFY_EMAIL the message with a link into the admin
# (ADMIN_URL, without trailing slash) and sends the visitor an acknowledgement. SES_FROM_EMAIL must be
# a verified SES identity. Required in production; leave SES_FROM_EMAIL empty elsewhere to turn the
# emails off
SES_FROM_EMAIL = ""
CONTACT_NOTIFY_EMAIL = ""
ADMIN_URL = "http://localhost:3001"

# Sentry DSN of the API's own project (optional; tracking is on when it is set)
SENTRY_DSN = ""

# Logging directory
LOG_DIR = "logs"

# Google reCAPTCHA v3 for the public contact form (https://www.google.com/recaptcha/admin, type
# "Score based (v3)"). The site key is public and inlined into the client at build time; the API keeps
# the secret and rejects submissions scoring below RECAPTCHA_MIN_SCORE (0.0 bot to 1.0 human; Google
# suggests 0.5). Required in production; leave empty elsewhere to turn the check off
NEXT_PUBLIC_RECAPTCHA_SITE_KEY = ""
RECAPTCHA_SECRET_KEY = ""
RECAPTCHA_MIN_SCORE = "0.5"

# Google Analytics Measurement ID for tracking site usage (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS = ""

# Microsoft Clarity project ID for session recording and heatmaps (optional)
NEXT_PUBLIC_MICROSOFT_CLARITY = ""

# Firebase Client Configuration (public web app values, inlined at build time; the API also reads the
# project ID to verify sign-in tokens)
NEXT_PUBLIC_FIREBASE_PROJECT_ID = ""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN = ""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID = ""
NEXT_PUBLIC_FIREBASE_API_KEY = ""
NEXT_PUBLIC_FIREBASE_APP_ID = ""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET = ""
NEXT_PUBLIC_FIREBASE_DATABASE_URL = ""

# Firebase Auth emulator for tests and CI only (apps/e2e); never set this in a deployment
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST = "127.0.0.1:9099"
