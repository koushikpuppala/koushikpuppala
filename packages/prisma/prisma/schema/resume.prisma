model Resume {
  id String @id @default(uuid()) @db.Uuid

  title       String  @default("Resume")
  versionName String? @map("version_name")

  headline     String?
  summary      String?  @db.Text
  highlights   Json?
  competencies String[]
  stats        Json?

  mediaId String @unique @map("media_id") @db.Uuid
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  fileSize Int?    @map("file_size")
  fileType String? @default("application/pdf") @map("file_type")
  checksum String?

  downloads Int @default(0)

  sortOrder Int @default(0) @map("sort_order")

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isPublished, deletedAt, sortOrder], map: "resume_published_deleted_sort_index")
  @@map("resume")
}
